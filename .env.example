# OpenAI-compatible provider settings. Never commit the real .env file.
MODEL_API_KEY=replace-me
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini
CODEPILOT_DEBUG=true

# Optional local directory. read_file can access only files below this root.
CODEPILOT_WORKSPACE_ROOT=workspace
# Optional V4 semantic retrieval. Leave both empty to use lexical + symbol fallback.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
